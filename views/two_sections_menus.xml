<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ===================================================================
         Two front doors added: Outreach and Campaigns.

         Outreach and Campaigns are put at the top level so the two jobs
         people actually do are one click from the home screen, instead of
         living inside the CRM app behind a door labelled something else.

         These menus are ADDED. Nothing existing is hidden, moved or renamed.
         An earlier version of this file deactivated every other top-level
         menu; that took Contacts, CRM, Calendar and Discuss away from people
         who were already using them, and broke crm.linkedtrust.us. Never
         again: add a door, never take one away.
         =================================================================== -->

    <!-- 1. Outreach: the list you work. Was a child of the CRM app, which put
         it behind a door labelled something else. It is the app now. -->
    <record id="menu_outreach_runner" model="ir.ui.menu">
        <field name="name">Outreach</field>
        <field name="parent_id" eval="False"/>
        <field name="action" ref="action_outreach_runner"/>
        <field name="web_icon">crm,static/description/icon.png</field>
        <field name="sequence" eval="1"/>
    </record>

    <!-- 2. Campaigns: what you are running, and the columns each one tracks.
         Stock utm action, stock views. -->
    <record id="menu_campaigns_root" model="ir.ui.menu">
        <field name="name">Campaigns</field>
        <field name="parent_id" eval="False"/>
        <field name="action" ref="utm.utm_campaign_action"/>
        <field name="web_icon">utm,static/description/icon.png</field>
        <field name="sequence" eval="2"/>
    </record>

</odoo>
