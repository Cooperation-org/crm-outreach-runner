<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- The addon stores the social links on the contact, but stock Odoo shows
         none of them. Without these inherits they are only visible in the
         Outreach Runner list, so anyone working a contact from the normal CRM
         sees no LinkedIn at all. Put them where the website already is: same
         group, url widget, one click out. LinkedIn and Bluesky are named
         fields because outreach runs on those two and they need to be list
         columns you can sort and filter; everything else goes in the open
         Other Socials list, so a new platform needs no code change.

         The same form carries Tax ID, Company ID, Reference and a Sales &
         Purchase tab. This database has no accounting installed and the work
         here is outreach, not billing, so those are hidden rather than left in
         the way. Hidden, not removed: nothing is deleted, and dropping the
         inherit brings them back. -->

    <record id="view_partner_form_outreach" model="ir.ui.view">
        <field name="name">res.partner.form.outreach</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">

            <field name="website" position="after">
                <field name="linkedin" widget="url"
                       placeholder="https://www.linkedin.com/in/..."/>
                <field name="bluesky" widget="url"
                       placeholder="https://bsky.app/profile/..."/>
                <field name="discord" widget="url"
                       placeholder="https://discord.gg/..."/>
            </field>

            <page name="internal_notes" position="before">
                <page name="socials" string="Other Socials">
                    <field name="social_ids">
                        <tree editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="platform"
                                   placeholder="Mastodon, Substack, Signal..."/>
                            <field name="url" widget="url"
                                   placeholder="https://mastodon.social/@..."/>
                        </tree>
                    </field>
                </page>
            </page>

            <field name="vat" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>
            <field name="company_registry" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>
            <field name="ref" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>
            <xpath expr="//page[@name='sales_purchases']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

        </field>
    </record>

    <!-- Opportunity form: the same links, on the record you actually work. -->
    <record id="view_crm_lead_form_outreach" model="ir.ui.view">
        <field name="name">crm.lead.form.outreach</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <field name="email_from" position="after">
                <field name="partner_linkedin" widget="url"
                       placeholder="https://www.linkedin.com/in/..."/>
                <field name="partner_bluesky" widget="url"
                       placeholder="https://bsky.app/profile/..."/>
                <field name="partner_discord" widget="url"
                       placeholder="https://discord.gg/..."/>
                <field name="committed_as"/>
            </field>
        </field>
    </record>

    <!-- Contacts list: LinkedIn as an optional column, off by default. -->
    <record id="view_partner_tree_outreach" model="ir.ui.view">
        <field name="name">res.partner.tree.outreach</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_tree"/>
        <field name="arch" type="xml">
            <field name="email" position="after">
                <field name="linkedin" widget="url" optional="hide"/>
                <field name="bluesky" widget="url" optional="hide"/>
            </field>
        </field>
    </record>

</odoo>
