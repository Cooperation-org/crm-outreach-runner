<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ===================================================================
         Two sections: Campaigns and Outreach. Nothing else.

         The CRM was not being used. Not because a feature was missing, but
         because five addons and stock CRM each hung their own menu on it, so
         doing one job meant choosing between eight doors, and people went back
         to a spreadsheet instead. The two things worth keeping are the
         outreach runner and the chatter, and both are reached from one list.

         Menus are deactivated, not deleted. Every action, view and record
         behind them is untouched: a menu is one boolean away from coming back,
         and anything reachable by URL or by a saved link still works.
         =================================================================== -->

    <!-- 1. Outreach: the list you work. Was a child of the CRM app, which put
         it behind a door labelled something else. It is the app now. -->
    <record id="menu_outreach_runner" model="ir.ui.menu">
        <field name="name">Outreach</field>
        <field name="parent_id" eval="False"/>
        <field name="action" ref="action_outreach_runner"/>
        <field name="web_icon">crm,static/description/icon.png</field>
        <field name="sequence" eval="1"/>
    </record>

    <!-- 2. Campaigns: what you are running, and the columns each one tracks.
         Stock utm action, stock views. -->
    <record id="menu_campaigns_root" model="ir.ui.menu">
        <field name="name">Campaigns</field>
        <field name="parent_id" eval="False"/>
        <field name="action" ref="utm.utm_campaign_action"/>
        <field name="web_icon">utm,static/description/icon.png</field>
        <field name="sequence" eval="2"/>
    </record>

    <!-- 3. Everything else, off. Stated as the rule rather than as a list of
         menus: a list goes stale the first time an addon adds a sixth one,
         and it cannot name menus in addons we do not depend on. Runs on every
         install and upgrade, so a deploy re-asserts it. -->
    <function model="ir.ui.menu" name="_outreach_keep_two_sections"/>

</odoo>
