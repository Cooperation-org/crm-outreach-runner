<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Dense outreach list: prioritized, key labels + clickable links, no click-in -->
    <record id="view_outreach_runner_tree" model="ir.ui.view">
        <field name="name">crm.lead.outreach.runner.tree</field>
        <field name="model">crm.lead</field>
        <field name="arch" type="xml">
            <!-- Types like a spreadsheet, on purpose. People keep going back
                 to Google Sheets because a CRM list makes you open a card to
                 change one cell. editable="bottom" puts the cursor in the
                 cell (Tab across, Enter to the next row); multi_edit lets you
                 select rows and set one column for all of them at once; and
                 open_form_view keeps the card, and its chatter, one click
                 away on every row instead of taking it away. -->
            <tree string="Outreach Runner"
                  editable="bottom"
                  multi_edit="1"
                  open_form_view="1"
                  default_order="outreach_pinned desc, outreach_seq asc, outreach_score desc"
                  decoration-muted="last_outreach_date != False"
                  decoration-bf="outreach_pinned == True"
                  sample="1">
                <!-- Carried, not shown. Same reason as the form below: an
                     editable list validates relational domains exactly like a
                     form, and partner_id / user_id / team_id are
                     check_company, so their domain reads company_id. A field
                     named in a domain must be in the view or the view does
                     not load. This is what broke the form in 16b71b2. -->
                <field name="company_id" column_invisible="1"/>
                <field name="team_id" column_invisible="1"/>
                <field name="outreach_seq" widget="handle"/>
                <field name="outreach_pinned" column_invisible="1"/>
                <field name="outreach_score_reason" column_invisible="1"/>
                <field name="priority" widget="priority"/>
                <field name="outreach_score" string="Rank" optional="show"/>
                <field name="partner_id" string="Contact"/>
                <field name="partner_function" string="Role" optional="show"/>
                <field name="campaign_id" optional="show"/>
                <field name="partner_category_ids" widget="many2many_tags" string="Tags" optional="show"/>
                <field name="email_from" widget="email" string="Email"/>
                <field name="partner_linkedin" widget="url" string="LinkedIn" optional="show"/>
                <field name="partner_discord" widget="url" string="Discord" optional="show"/>
                <field name="partner_website" widget="url" string="Site" optional="hide"/>
                <field name="phone" widget="phone" optional="hide"/>
                <field name="last_outreach_date" string="Last outreach" optional="show"/>
                <!-- This campaign's own columns. Each renders as a real,
                     sortable, filterable column, not a blob in Notes. -->
                <field name="lead_properties"/>
                <button name="action_mark_contacted" type="object" string="Contacted"
                        icon="fa-check" class="btn-link"
                        help="Log outreach: stamp the time and add a chatter note"/>
            </tree>
        </field>
    </record>

    <!-- Kanban "runner" cards -->
    <record id="view_outreach_runner_kanban" model="ir.ui.view">
        <field name="name">crm.lead.outreach.runner.kanban</field>
        <field name="model">crm.lead</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" default_order="outreach_pinned desc, outreach_seq asc, outreach_score desc" sample="1">
                <field name="priority"/>
                <field name="partner_id"/>
                <field name="partner_function"/>
                <field name="campaign_id"/>
                <field name="email_from"/>
                <field name="partner_linkedin"/>
                <field name="partner_discord"/>
                <field name="partner_website"/>
                <field name="partner_category_ids"/>
                <field name="last_outreach_date"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_record_top mb-1">
                                <strong class="o_kanban_record_title">
                                    <field name="partner_id"/>
                                </strong>
                                <field name="priority" widget="priority"/>
                            </div>
                            <div class="text-muted small">
                                <field name="partner_function"/> · <field name="campaign_id"/>
                            </div>
                            <div class="mt-1">
                                <field name="partner_category_ids" widget="many2many_tags"/>
                            </div>
                            <div class="o_kanban_record_bottom mt-2">
                                <div class="oe_kanban_bottom_left">
                                    <a t-if="record.email_from.raw_value"
                                       t-att-href="'mailto:' + record.email_from.raw_value"
                                       class="btn btn-sm btn-link" title="Email">✉</a>
                                    <a t-if="record.partner_linkedin.raw_value"
                                       t-att-href="record.partner_linkedin.raw_value"
                                       target="_blank" class="btn btn-sm btn-link" title="LinkedIn">in</a>
                                    <a t-if="record.partner_discord.raw_value"
                                       t-att-href="record.partner_discord.raw_value"
                                       target="_blank" class="btn btn-sm btn-link" title="Discord">D</a>
                                    <a t-if="record.partner_website.raw_value"
                                       t-att-href="record.partner_website.raw_value"
                                       target="_blank" class="btn btn-sm btn-link" title="Website">↗</a>
                                </div>
                                <div class="oe_kanban_bottom_right">
                                    <button name="action_mark_contacted" type="object"
                                            class="btn btn-sm btn-primary">Contacted</button>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Search: filter/group by campaign, priority, not-yet-contacted -->
    <record id="view_outreach_runner_search" model="ir.ui.view">
        <field name="name">crm.lead.outreach.runner.search</field>
        <field name="model">crm.lead</field>
        <field name="arch" type="xml">
            <search string="Outreach">
                <field name="partner_id" string="Contact"/>
                <field name="campaign_id"/>
                <field name="partner_category_ids" string="Tag"/>
                <field name="lead_properties" string="Outreach Columns"/>
                <filter name="not_contacted" string="Not yet contacted"
                        domain="[('last_outreach_date','=',False)]"/>
                <filter name="high_priority" string="High priority"
                        domain="[('priority','&gt;=','2')]"/>
                <separator/>
                <filter name="my" string="My leads" domain="[('user_id','=',uid)]"/>
                <group expand="1" string="Group By">
                    <filter name="by_campaign" string="Campaign" context="{'group_by':'campaign_id'}"/>
                    <filter name="by_priority" string="Priority" context="{'group_by':'priority'}"/>
                    <filter name="by_properties" string="Outreach Columns"
                            context="{'group_by':'lead_properties'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Outreach card. The stock lead form is built for a sales pipeline:
         expected revenue, probability, expected closing, recurring plan, lost
         reason, medium/source. None of that is knowable when the job is "ask
         this organisation for something", and it buried the two things that
         are: how to reach them, and what we know about them. This is a
         standalone form, not an inherit, so the pipeline fields cannot leak
         back in one Odoo upgrade at a time. Nothing is deleted: the stock form
         is untouched and still opens everywhere else in CRM.

         Two note fields on purpose, one home per fact. "The ask" is ours —
         what we want and why we think they would say yes. "About them" is the
         contact's own Notes, facts about the organisation (what they have
         funded, how much, how to apply) that stay true no matter who asks. -->
    <record id="view_outreach_runner_form" model="ir.ui.view">
        <field name="name">crm.lead.outreach.runner.form</field>
        <field name="model">crm.lead</field>
        <field name="arch" type="xml">
            <form string="Outreach">
                <!-- Carried, not shown. A form is editable, so Odoo validates
                     the domain of every relational field in it: stage_id's own
                     domain reads team_id, and partner_id / user_id / team_id
                     are check_company, so their domain reads company_id. A
                     field named in a domain must be in the view or the view
                     does not load. The stock lead form carries the same two the
                     same way. -->
                <field name="company_id" invisible="1"/>
                <field name="team_id" invisible="1"/>
                <header>
                    <button name="action_mark_contacted" type="object"
                            string="Log outreach" class="btn-primary"
                            help="Stamp the time and add a chatter note"/>
                    <field name="stage_id" widget="statusbar"
                           options="{'clickable': '1'}"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="The ask"/>
                        <h1><field name="name" placeholder="Sponsor ask: ..."/></h1>
                    </div>
                    <group>
                        <group string="Who to ask">
                            <field name="partner_id" string="Contact"/>
                            <field name="partner_function" string="Role"/>
                            <field name="partner_category_ids"
                                   widget="many2many_tags" string="Tags"/>
                            <field name="campaign_id"/>
                            <field name="user_id" string="Ours to run"/>
                        </group>
                        <group string="How to reach them">
                            <field name="email_from" widget="email" string="Email"/>
                            <field name="phone" widget="phone"/>
                            <field name="partner_website" widget="url" string="Site"/>
                            <field name="partner_linkedin" widget="url" string="LinkedIn"/>
                            <field name="partner_bluesky" widget="url" string="Bluesky"/>
                            <field name="partner_discord" widget="url" string="Discord"/>
                        </group>
                    </group>
                    <group>
                        <group string="Where it stands">
                            <field name="priority" widget="priority"/>
                            <field name="outreach_score" string="Rank"/>
                            <field name="outreach_score_reason" string="Why that rank"/>
                        </group>
                        <group>
                            <field name="outreach_pinned" string="Pinned"/>
                            <field name="last_outreach_date" string="Last outreach"/>
                        </group>
                    </group>
                    <!-- Where a campaign's columns get added and renamed. The
                         definition is shared by every row on the campaign, so
                         adding one here adds the column to the whole list. -->
                    <field name="lead_properties" columns="2"/>
                    <notebook>
                        <page name="the_ask" string="The ask">
                            <field name="description"
                                   placeholder="What we want, and why they might say yes."/>
                        </page>
                        <page name="about_them" string="About them">
                            <field name="partner_notes"
                                   placeholder="What this organisation has funded, how much, and how to apply."/>
                        </page>
                        <page name="socials" string="Other socials">
                            <field name="partner_social_ids">
                                <tree editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="platform"/>
                                    <field name="url" widget="url"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_outreach_runner" model="ir.actions.act_window">
        <field name="name">Outreach Runner</field>
        <field name="res_model">crm.lead</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="domain">[('type','=','opportunity')]</field>
        <field name="search_view_id" ref="view_outreach_runner_search"/>
        <!-- default_type: the action's domain filters to opportunities, but a
             row typed into the list still has to be created as one. Without
             it, a new row saves as a lead and vanishes from the view. -->
        <field name="context">{'search_default_not_contacted': 1, 'search_default_by_campaign': 1, 'default_type': 'opportunity'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Nothing to reach out to yet</p>
            <p>Opportunities on your campaigns show up here, prioritized for outreach.</p>
        </field>
    </record>

    <!-- Bind our specific tree + kanban to the action -->
    <record id="outreach_runner_act_tree" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">tree</field>
        <field name="view_id" ref="view_outreach_runner_tree"/>
        <field name="act_window_id" ref="action_outreach_runner"/>
    </record>
    <record id="outreach_runner_act_kanban" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">kanban</field>
        <field name="view_id" ref="view_outreach_runner_kanban"/>
        <field name="act_window_id" ref="action_outreach_runner"/>
    </record>
    <record id="outreach_runner_act_form" model="ir.actions.act_window.view">
        <field name="sequence" eval="3"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_outreach_runner_form"/>
        <field name="act_window_id" ref="action_outreach_runner"/>
    </record>

    <!-- Menu under CRM -->
    <menuitem id="menu_outreach_runner"
              name="Outreach Runner"
              parent="crm.crm_menu_root"
              action="action_outreach_runner"
              sequence="20"/>

</odoo>
